BACKEND_ENV_FILE=.env.docker.example

SPRING_PROFILE=prod
SPRING_JPA_HIBERNATE_DDL_AUTO=update

DB_ROOT_PASSWORD=your_strong_root_password
DB_URL=jdbc:mysql://mysql:3306/topviec_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh
DB_USERNAME=topviec_user
DB_PASSWORD=your_strong_db_password

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_gmail_app_password

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DATABASE=0
REDIS_TIMEOUT=2000ms
REDIS_POOL_MAX_ACTIVE=8
REDIS_POOL_MAX_IDLE=8
REDIS_POOL_MIN_IDLE=2
REDIS_POOL_MAX_WAIT=-1ms

JWT_SECRET=your_very_long_jwt_secret_key_min_32_chars
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

VERIFY_EMAIL_TTL=1440
RESET_PASSWORD_TTL=15
VERIFY_EMAIL_PREFIX=verify-email
RESET_PASSWORD_PREFIX=reset-password
INTERVIEW_UPDATE_TTL=7

APP_BASE_URL=https://your-domain.com
APP_VERIFY_EMAIL_URL=https://your-domain.com/verify-email/callback
APP_RESET_PASSWORD_URL=https://your-domain.com/reset-password
APP_CONFIRM_INTERVIEW_URL=https://your-domain.com/interview-confirm-update
APP_SLOT_SELECTION_URL=https://your-domain.com/interview-select-slot
APP_TALENT_POOL_INVITE_URL=https://your-domain.com/talent-pool-invite
CORS_ALLOWED_ORIGINS=https://your-domain.com

VNPAY_TMN_CODE=your_vnpay_code
VNPAY_HASH_SECRET=your_vnpay_secret
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=http://your-ec2-ip:8080/api/v1/payment/vnpay/return
VNPAY_FRONTEND_RETURN_URL=https://your-domain.com/payment/result

STORAGE_BASE_URL=http://your-ec2-ip:8080/api/v1/files

CLOUDINARY_FOLDER_ROOT=topviec
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER_CV=cvs
CLOUDINARY_FOLDER_AVATAR=avatars
CLOUDINARY_FOLDER_COMPANY_COVER=company-covers
